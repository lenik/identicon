#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr ""
"Pemakaian: identicon [OPSI]... ID\n"
"Hasilkan gambar avatar deterministik dari ID.\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "campurkan SALT ke dalam hash (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "tulis citra ke FILE; format mengikuti ekstensi (baku: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "gaya avatar (baku: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "pola piksel kaleidoskop\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "wajah kartun dengan ekspresi dan warna latar yang berbeda\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "monster piksel berwarna dengan penampilan khas\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "wajah piksel 8-bit era NES\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "robot kecil yang menggemaskan\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "format citra: jpg, gif, png, bmp, ... (baku: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "ukuran dalam piksel (baku: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "warna latar: nama, #rgb, #rrggbb, atau rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "timpa FILE jika sudah ada\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "ulangi untuk log yang lebih rinci\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "tampilkan lebih sedikit pesan log\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "tampilkan bantuan ini lalu keluar\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "tampilkan informasi versi lalu keluar\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "ID dan SALT dikodekan sebagai UTF-8.\n"

#: src/identicon.py:68
#, python-brace-format
msgid "Report bugs to: <{email}>\n"
msgstr "Laporkan kutu ke: <{email}>\n"

#: src/identicon.py:73
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "Hak cipta (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Lisensi AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Ini perangkat lunak bebas: Anda boleh mengubah dan menyebarkannya.\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Proyek ini menentang eksploitasi dan hegemoni AI.\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "Proyek ini menolak lisensi bergaya MIT yang tanpa pikir dan BSD yang naif secara politik.\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "TIDAK ADA JAMINAN, sejauh diizinkan hukum.\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "ukuran tidak sah {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "ID tidak ada"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "argumen ekstra: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "jenis tidak dikenal {value!r} (diharapkan {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "warna tidak sah {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "format tidak dikenal {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} sudah ada (pakai --force untuk menimpa)"
