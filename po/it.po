#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr "Uso: identicon [OPZIONE]... ID\nGenera un’immagine avatar deterministica da ID.\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "mescola SALT nell’hash (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "scrivi l’immagine su FILE; il formato segue l’estensione (predefinito: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "stile dell’avatar (predefinito: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "motivo pixel caleidoscopico\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "volti a fumetti con espressioni e sfondi di colori diversi\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "mostri pixel colorati dal look distintivo\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "volti pixel 8 bit dell’era NES\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "piccoli robot carini\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "formato immagine: jpg, gif, png, bmp, ... (predefinito: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "dimensione in pixel (predefinito: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "colore di sfondo: nome, #rgb, #rrggbb, oppure rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "sovrascrivi FILE se esiste già\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "ripetere per registri più dettagliati\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "mostra meno messaggi di registro\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "mostra questo aiuto ed esci\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "mostra le informazioni di versione ed esci\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "ID e SALT sono codificati in UTF-8.\n"

#: src/identicon.py:68
msgid "Report bugs to: <{email}>\n"
msgstr "Segnalare i bug a: <{email}>\n"

#: src/identicon.py:73
msgid "Copyright (C) {year} {author}\n"
msgstr "Diritti d’autore (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Licenza AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Questo è software libero: puoi modificarlo e ridistribuirlo.\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Questo progetto si oppone allo sfruttamento e all’egemonia dell’IA.\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "Questo progetto rifiuta le licenze MIT sconsiderate e quelle BSD politicamente ingenue.\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "NON c’è ALCUNA GARANZIA, nei limiti consentiti dalla legge.\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "dimensione non valida {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "ID mancante"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "argomento extra: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "tipo sconosciuto {value!r} (attesi {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "colore non valido {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "formato sconosciuto {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} esiste già (usa --force per sovrascrivere)"
