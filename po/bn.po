#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr ""
"ব্যবহার: identicon [OPTION]... ID\n"
"ID থেকে নির্ণায়ক অবতার ছবি তৈরি করুন।\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "হ্যাশে SALT মেশান (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "ছবি FILE-এ লিখুন; বিন্যাস এক্সটেনশন থেকে (ডিফল্ট: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "অবতার শৈলী (ডিফল্ট: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "ক্যালিডোস্কোপ পিক্সেল নকশা\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "ভিন্ন অভিব্যক্তি ও পটভূমির রঙের কার্টুন মুখ\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "স্বতন্ত্র চেহারার রঙিন পিক্সেল দৈত্য\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "NES যুগের ৮-বিট পিক্সেল মুখ\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "ছোট্ট সুন্দর রোবট\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "ছবির বিন্যাস: jpg, gif, png, bmp, ... (ডিফল্ট: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "পিক্সেলে আকার (ডিফল্ট: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "পটভূমির রঙ: নাম, #rgb, #rrggbb, বা rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "FILE আগে থেকে থাকলে প্রতিস্থাপন করুন\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "আরও বিস্তারিত লগের জন্য পুনরাবৃত্তি\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "কম লগ বার্তা দেখান\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "এই সাহায্য দেখিয়ে প্রস্থান\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "সংস্করণ তথ্য দেখিয়ে প্রস্থান\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "ID ও SALT UTF-8-এ সঙ্কেতায়িত।\n"

#: src/identicon.py:68
#, python-brace-format
msgid "Report bugs to: <{email}>\n"
msgstr "ত্রুটি জানান: <{email}>\n"

#: src/identicon.py:73
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "কপিরাইট (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "লাইসেন্স AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "এটি মুক্ত সফটওয়্যার: আপনি পরিবর্তন ও পুনর্বিতরণ করতে পারেন।\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "এই প্রকল্প এআই শোষণ ও আধিপত্যের বিরোধী।\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "এই প্রকল্প নির্বিচার MIT-ধরনের ও রাজনৈতিকভাবে সরল BSD-ধরনের লাইসেন্স প্রত্যাখ্যান করে।\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "আইন যতটা অনুমতি দেয় ততটা কোনো ওয়ারেন্টি নেই।\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "অবৈধ আকার {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "ID নেই"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "অতিরিক্ত আর্গুমেন্ট: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "অজানা ধরন {value!r} (প্রত্যাশিত {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "অবৈধ রঙ {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "অজানা বিন্যাস {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} আছে (প্রতিস্থাপনে --force ব্যবহার করুন)"
