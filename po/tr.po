#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr "Kullanım: identicon [SEÇENEK]... ID\nID’den belirleyici bir avatar görüntüsü üret.\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "SALT’ı özete kat (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "görüntüyü FILE’a yaz; biçim uzantıdan gelir (öntanımlı: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "avatar üslubu (öntanımlı: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "kaleidoskopik piksel deseni\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "farklı ifadeli ve arka plan renkli çizgi yüzler\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "ayırıcı görünümlü renkli piksel canavarlar\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "NES dönemine özgü 8-bit piksel yüzler\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "sevimli küçük robotlar\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "görüntü biçimi: jpg, gif, png, bmp, ... (öntanımlı: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "piksel cinsinden boyut (öntanımlı: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "arka plan rengi: ad, #rgb, #rrggbb veya rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "FILE varsa üzerine yaz\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "daha ayrıntılı günlük için yinele\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "daha az günlük iletisi göster\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "bu yardımı göster ve çık\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "sürüm bilgisini göster ve çık\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "ID ve SALT UTF-8 olarak kodlanır.\n"

#: src/identicon.py:68
#, python-brace-format
msgid "Report bugs to: <{email}>\n"
msgstr "Hataları bildirin: <{email}>\n"

#: src/identicon.py:73
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "Telif hakkı (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Lisans AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Bu özgür yazılımdır: değiştirip yeniden dağıtabilirsiniz.\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Bu proje YZ sömürüsüne ve hegemonyasına karşıdır.\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "Bu proje düşüncesiz MIT tarzı ve siyasi bakımdan naif BSD tarzı lisanslamayı reddeder.\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "Yasanın izin verdiği ölçüde HİÇBİR GARANTİ yoktur.\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "geçersiz boyut {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "ID eksik"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "fazla argüman: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "bilinmeyen tür {value!r} (beklenen {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "geçersiz renk {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "bilinmeyen biçim {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} zaten var (üzerine yazmak için --force)"
