#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr "Cách dùng: identicon [TÙY CHỌN]... ID\nTạo ảnh avatar xác định từ ID.\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "trộn SALT vào hàm băm (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "ghi ảnh ra FILE; định dạng theo phần mở rộng (mặc định: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "kiểu avatar (mặc định: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "hoa văn pixel kính vạn hoa\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "mặt hoạt hình với biểu cảm và màu nền khác nhau\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "quái vật pixel sặc sỡ với vẻ ngoài riêng\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "khuôn mặt pixel 8-bit thời NES\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "những robot nhỏ dễ thương\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "định dạng ảnh: jpg, gif, png, bmp, ... (mặc định: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "kích thước theo pixel (mặc định: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "màu nền: tên, #rgb, #rrggbb, hoặc rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "ghi đè FILE nếu đã tồn tại\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "lặp lại để ghi nhật ký chi tiết hơn\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "hiện ít thông báo nhật ký hơn\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "hiện trợ giúp này và thoát\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "hiện thông tin phiên bản và thoát\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "ID và SALT được mã hóa UTF-8.\n"

#: src/identicon.py:68
msgid "Report bugs to: <{email}>\n"
msgstr "Báo lỗi tới: <{email}>\n"

#: src/identicon.py:73
msgid "Copyright (C) {year} {author}\n"
msgstr "Bản quyền (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Giấy phép AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Đây là phần mềm tự do: bạn được sửa và phân phối lại.\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Dự án này phản đối bóc lột AI và bá quyền AI.\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "Dự án này từ chối giấy phép kiểu MIT vô ý và kiểu BSD ngây thơ về chính trị.\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "KHÔNG CÓ BẢO ĐẢM, trong phạm vi pháp luật cho phép.\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "kích thước không hợp lệ {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "thiếu ID"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "đối số thừa: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "kiểu không rõ {value!r} (kỳ vọng {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "màu không hợp lệ {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "định dạng không rõ {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} đã tồn tại (dùng --force để ghi đè)"
