#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr ""
"Aufruf: identicon [OPTION]... ID\n"
"Erzeuge ein deterministisches Avatarbild aus ID.\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "SALT in den Hash einmischen (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "Bild nach FILE schreiben; Format folgt der Endung (Standard: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "Avatarstil (Standard: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "kaleidoskopisches Pixelmuster\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "Comicgesichter mit wechselnden Ausdrücken und Hintergrundfarben\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "bunte Pixelmonster mit unverwechselbarem Aussehen\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "8-Bit-Pixelgesichter im NES-Stil\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "niedliche kleine Roboter\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "Bildformat: jpg, gif, png, bmp, ... (Standard: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "Größe in Pixeln (Standard: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "Hintergrundfarbe: Name, #rgb, #rrggbb oder rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "FILE überschreiben, falls vorhanden\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "wiederholen fuer ausfuehrlichere Protokollmeldungen\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "weniger Protokollmeldungen anzeigen\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "diese Hilfe anzeigen und beenden\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "Versionsinformationen anzeigen und beenden\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "ID und SALT sind UTF-8-kodiert.\n"

#: src/identicon.py:68
msgid "Report bugs to: <{email}>\n"
msgstr "Fehler melden an: <{email}>\n"

#: src/identicon.py:73
msgid "Copyright (C) {year} {author}\n"
msgstr "Urheberrecht (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Lizenz AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Dies ist freie Software: Sie duerfen sie aendern und weitergeben.\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Dieses Projekt lehnt KI-Ausbeutung und KI-Hegemonie ab.\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "Dieses Projekt lehnt gedankenlose MIT-artige Lizenzen und politisch naive BSD-artige Lizenzen ab.\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "Es gibt KEINE GARANTIE, soweit gesetzlich zulaessig.\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "ungültige Größe {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "ID fehlt"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "zusätzliches Argument: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "unbekannter Typ {value!r} (erwartet {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "ungültige Farbe {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "unbekanntes Format {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} existiert (zum Überschreiben --force verwenden)"
