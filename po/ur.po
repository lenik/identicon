#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr "استعمال: identicon [اختیار]... ID\nشناختی ID سے تعین شدہ اوتار تصویر بنائیں۔\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "ہیش میں SALT ملائیں (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "تصویر FILE میں لکھیں؛ ہیئت توسیع سے آتی ہے (طے شدہ: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "اوتار انداز (طے شدہ: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "کیلیدوسکوپ پکسل نقش\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "مختلف تاثرات اور پس منظر رنگوں والے کارٹون چہرے\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "منفرد شکل والے رنگین پکسل غول\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "NES دور کے 8-بٹ پکسل چہرے\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "پیارے چھوٹے روبوٹ\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "تصویری ہیئت: jpg, gif, png, bmp, ... (طے شدہ: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "پکسل میں سائز (طے شدہ: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "پس منظر رنگ: نام، #rgb، #rrggbb، یا rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "FILE پہلے سے ہو تو اوور رائٹ کریں\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "زیادہ تفصیلی لاگ کے لیے دہرائیں\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "کم لاگ پیغام دکھائیں\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "یہ مدد دکھا کر خارج ہوں\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "ورژن معلومات دکھا کر خارج ہوں\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "ID اور SALT یو ٹی ایف-۸ میں رمزبند ہیں۔\n"

#: src/identicon.py:68
#, python-brace-format
msgid "Report bugs to: <{email}>\n"
msgstr "نقائص کی اطلاع: <{email}>\n"

#: src/identicon.py:73
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "حقوق نشر (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "اجازہ AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "یہ آزاد سافٹ ویئر ہے: آپ اسے بدل اور پھیل سکتی/سکتے ہیں۔\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "یہ منصوبہ اے آئی استحصال اور غلبے کا مخالف ہے۔\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "یہ منصوبہ بے سوچ MIT نما اور سیاسی طور پر سادہ لوح BSD نما اجازت نامے مسترد کرتا ہے۔\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "قانون کی اجازت تک کوئی وارنٹی نہیں۔\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "غلط سائز {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "ID موجود نہیں"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "اضافی دلیل: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "نامعلوم قسم {value!r} (متوقع {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "غلط رنگ {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "نامعلوم ہیئت {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} موجود ہے (اوور رائٹ کے لیے --force)"
