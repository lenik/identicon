#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr "பயன்: identicon [OPTION]... ID\nID-இலிருந்து நிர்ணயமான அவதாரப் படத்தை உருவாக்கும்.\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "ஹாஷில் SALT கலக்கும் (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "படத்தை FILE-இல் எழுதும்; வடிவம் நீட்சியைப் பின்பற்றும் (இயல்பு: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "அவதாரப் பாணி (இயல்பு: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "கலைடோஸ்கோப் பிக்சல் வடிவம்\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "வேறுபட்ட பாவனைகளும் பின்னணி நிறங்களும் கொண்ட கார்ட்டூன் முகங்கள்\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "தனித்த தோற்றம் கொண்ட வண்ணப் பிக்சல் அரக்கர்கள்\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "NES கால 8-பிட் பிக்சல் முகங்கள்\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "அன்பான சிறிய ரோபோக்கள்\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "பட வடிவம்: jpg, gif, png, bmp, ... (இயல்பு: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "பிக்சல் அளவு (இயல்பு: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "பின்னணி நிறம்: பெயர், #rgb, #rrggbb அல்லது rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "FILE ஏற்கெனவே இருந்தால் மேலெழுதும்\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "மேலும் விரிவான பதிவுக்கு மீண்டும் குறிப்பிடவும்\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "குறைந்த பதிவுச் செய்திகளைக் காட்டும்\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "இந்த உதவியைக் காட்டி வெளியேறும்\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "பதிப்புத் தகவலைக் காட்டி வெளியேறும்\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "ID மற்றும் SALT UTF-8 இல் குறியிடப்படும்.\n"

#: src/identicon.py:68
#, python-brace-format
msgid "Report bugs to: <{email}>\n"
msgstr "பிழைகளை அறிவிக்க: <{email}>\n"

#: src/identicon.py:73
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "பதிப்புரிமை (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "உரிமம் AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "இது கட்டற்ற மென்பொருள்: மாற்றி மீள்பகிரலாம்.\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "இத்திட்டம் செயற்கை நுண்ணறிவு சுரண்டலுக்கும் ஆதிக்கத்துக்கும் எதிர்.\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "இத்திட்டம் சிந்தனையற்ற MIT-பாணி உரிமங்களையும் அரசியல் அப்பாவி BSD-பாணி உரிமங்களையும் நிராகரிக்கும்.\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "சட்டம் அனுமதிக்கும் அளவுக்கு எந்த உத்தரவாதமும் இல்லை.\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "செல்லாத அளவு {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "ID இல்லை"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "கூடுதல் தருமதிப்பு: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "தெரியாத வகை {value!r} (எதிர்பார்ப்பது {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "செல்லாத நிறம் {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "தெரியாத வடிவம் {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} உள்ளது (மேலெழுத --force பயன்படுத்தவும்)"
