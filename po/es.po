#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr "Uso: identicon [OPCIÓN]... ID\nGenera una imagen de avatar determinista a partir de ID.\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "mezclar SALT en el hash (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "escribir la imagen en FILE; el formato sigue la extensión (predeterminado: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "estilo de avatar (predeterminado: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "patrón de píxeles caleidoscópico\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "caras de dibujos con expresiones y fondos de colores distintos\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "monstruos de píxeles coloridos y aspecto distintivo\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "caras de píxeles de 8 bits de la era NES\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "pequeños robots adorables\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "formato de imagen: jpg, gif, png, bmp, ... (predeterminado: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "tamaño en píxeles (predeterminado: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "color de fondo: nombre, #rgb, #rrggbb o rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "sobrescribir FILE si ya existe\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "repetir para más mensajes de registro\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "mostrar menos mensajes de registro\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "mostrar esta ayuda y salir\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "mostrar la información de versión y salir\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "ID y SALT se codifican en UTF-8.\n"

#: src/identicon.py:68
#, python-brace-format
msgid "Report bugs to: <{email}>\n"
msgstr "Informar de errores a: <{email}>\n"

#: src/identicon.py:73
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "Derechos de autor (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Licencia AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Esto es software libre: puede modificarlo y redistribuirlo.\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Este proyecto se opone a la explotación y la hegemonía de la IA.\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "Este proyecto rechaza las licencias MIT irreflexivas y las BSD políticamente ingenuas.\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "NO HAY GARANTÍA, en la medida permitida por la ley.\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "tamaño no válido {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "falta el ID"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "argumento de más: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "tipo desconocido {value!r} (se esperaba {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "color no válido {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "formato desconocido {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} ya existe (use --force para sobrescribir)"
