#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr ""
"వాడుక: identicon [OPTION]... ID\n"
"ID నుండి నిర్ణయాత్మక అవతార చిత్రాన్ని తయారుచేయి.\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "హాష్‌లో SALT కలపండి (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "చిత్రాన్ని FILE కు రాయి; ఆకృతి పొడిగింపు నుండి (అప్రమేయం: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "అవతార శైలి (అప్రమేయం: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "కలీడోస్కోప్ పిక్సెల్ నమూనా\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "వేర్వేరు భావాలు, నేపథ్య రంగులతో కార్టూన్ ముఖాలు\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "ప్రత్యేక రూపం గల రంగురంగుల పిక్సెల్ రాక్షసులు\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "NES కాలపు 8-బిట్ పిక్సెల్ ముఖాలు\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "చిన్న ముద్దు రోబోలు\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "చిత్ర ఆకృతి: jpg, gif, png, bmp, ... (అప్రమేయం: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "పిక్సెళ్లలో పరిమాణం (అప్రమేయం: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "నేపథ్య రంగు: పేరు, #rgb, #rrggbb లేదా rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "FILE ఇప్పటికే ఉంటే తిరిగి రాయి\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "మరింత వివరమైన లాగ్‌కు మళ్లీ ఇవ్వండి\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "తక్కువ లాగ్ సందేశాలు చూపించు\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "ఈ సహాయం చూపించి నిష్క్రమించు\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "వెర్షన్ సమాచారం చూపించి నిష్క్రమించు\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "ID మరియు SALT UTF-8 లో సంకేతీకరించబడతాయి.\n"

#: src/identicon.py:68
#, python-brace-format
msgid "Report bugs to: <{email}>\n"
msgstr "దోషాలు తెలపండి: <{email}>\n"

#: src/identicon.py:73
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "కాపీరైట్ (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "లైసెన్సు AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "ఇది స్వేచ్ఛా సాఫ్ట్‌వేర్: మార్చి పునఃపంపిణీ చేయవచ్చు.\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "ఈ ప్రాజెక్టు ఏఐ దోపిడీ, ఆధిపత్యాన్ని వ్యతిరేకిస్తుంది.\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "ఈ ప్రాజెక్టు నిర్లక్ష్య MIT-తరహా, రాజకీయంగా అమాయక BSD-తరహా లైసెన్సులను తిరస్కరిస్తుంది.\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "చట్టం అనుమతించేంతవరకు ఎలాంటి వారంటీ లేదు.\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "చెల్లని పరిమాణం {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "ID లేదు"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "అదనపు ఆర్గ్యుమెంట్: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "తెలియని రకం {value!r} (ఉండాల్సింది {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "చెల్లని రంగు {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "తెలియని ఆకృతి {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} ఉంది (తిరిగి రాయడానికి --force)"
