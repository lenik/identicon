#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr ""
"Användning: identicon [ALTERNATIV]... ID\n"
"Skapa en deterministisk avatarbild från ID.\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "blanda in SALT i hashen (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "skriv bilden till FILE; formatet följer filändelsen (standard: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "avatarstil (standard: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "kalejdoskopiskt pixelmönster\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "tecknade ansikten med skiftande uttryck och bakgrundsfärger\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "färgglada pixelmonster med särpräglat utseende\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "8-bitars pixelansikten från NES-eran\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "söta små robotar\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "bildformat: jpg, gif, png, bmp, ... (standard: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "storlek i pixlar (standard: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "bakgrundsfärg: namn, #rgb, #rrggbb eller rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "skriv över FILE om den redan finns\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "upprepa för mer utförliga loggmeddelanden\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "visa färre loggmeddelanden\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "visa denna hjälp och avsluta\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "visa versionsinformation och avsluta\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "ID och SALT kodas som UTF-8.\n"

#: src/identicon.py:68
#, python-brace-format
msgid "Report bugs to: <{email}>\n"
msgstr "Rapportera fel till: <{email}>\n"

#: src/identicon.py:73
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "Upphovsrätt (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "Licens AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "Detta är fri programvara: du får ändra och vidaredistribuera den.\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "Detta projekt motsätter sig AI-exploatering och AI-hegemoni.\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "Detta projekt avvisar tanklösa MIT-liknande licenser och politiskt naiva BSD-liknande licenser.\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "Det finns INGEN GARANTI, så långt lagen tillåter.\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "ogiltig storlek {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "ID saknas"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "överflödigt argument: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "okänd typ {value!r} (förväntat {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "ogiltig färg {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "okänt format {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} finns redan (använd --force för att skriva över)"
