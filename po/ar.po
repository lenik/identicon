#: src/identicon.py:30
msgid ""
"Usage: identicon [OPTION]... ID\n"
"Generate a deterministic avatar image from ID.\n"
msgstr ""
"استعمال: identicon [خيار]... ID\n"
"توليد صورة أفاتار حتمية من المعرّف ID.\n"

#: src/identicon.py:35
msgid "mix SALT into the hash (UTF-8)\n"
msgstr "خلط الملح SALT في التجزئة (UTF-8)\n"

#: src/identicon.py:37
msgid "write the image to FILE; format follows the extension (default: stdout)\n"
msgstr "كتابة الصورة إلى FILE؛ الصيغة تُستنتج من الامتداد (الافتراضي: stdout)\n"

#: src/identicon.py:39
msgid "avatar style (default: identicon)\n"
msgstr "نمط الأفاتار (الافتراضي: identicon)\n"

#: src/identicon.py:41
msgid "kaleidoscopic pixel pattern\n"
msgstr "نمط بكسل كاليدوسكوبي\n"

#: src/identicon.py:43
msgid "cartoon faces with varying expressions and background colors\n"
msgstr "وجوه كرتونية بتعابير وألوان خلفية مختلفة\n"

#: src/identicon.py:45
msgid "colorful pixel monsters with distinctive looks\n"
msgstr "وحوش بكسل ملونة بملامح مميزة\n"

#: src/identicon.py:47
msgid "8-bit NES-era pixel faces\n"
msgstr "وجوه بكسل ثمانية البت من عصر NES\n"

#: src/identicon.py:49
msgid "cute little robots\n"
msgstr "روبوتات صغيرة لطيفة\n"

#: src/identicon.py:51
msgid "image format: jpg, gif, png, bmp, ... (default: png)\n"
msgstr "صيغة الصورة: jpg، gif، png، bmp، ... (الافتراضي: png)\n"

#: src/identicon.py:53
msgid "size in pixels (default: 256)\n"
msgstr "الحجم بالبكسل (الافتراضي: 256)\n"

#: src/identicon.py:55
msgid "background color: name, #rgb, #rrggbb, or rgb/hsl[a](...)\n"
msgstr "لون الخلفية: اسم، #rgb، #rrggbb، أو rgb/hsl[a](...)\n"

#: src/identicon.py:57
msgid "overwrite FILE if it already exists\n"
msgstr "استبدال FILE إن كان موجوداً\n"

#: src/identicon.py:59
msgid "repeat for more verbose loggings\n"
msgstr "كرر للمزيد من سجلات التفصيل\n"

#: src/identicon.py:61
msgid "show less logging messages\n"
msgstr "إظهار رسائل سجل أقل\n"

#: src/identicon.py:63
msgid "display this help and exit\n"
msgstr "عرض هذه المساعدة والخروج\n"

#: src/identicon.py:65
msgid "output version information and exit\n"
msgstr "إخراج معلومات الإصدار والخروج\n"

#: src/identicon.py:67
msgid "ID and SALT are UTF-8 encoded.\n"
msgstr "يُرمَّز ID والملح SALT بـ UTF-8.\n"

#: src/identicon.py:68
#, python-brace-format
msgid "Report bugs to: <{email}>\n"
msgstr "بلّغ عن العلل إلى: <{email}>\n"

#: src/identicon.py:73
#, python-brace-format
msgid "Copyright (C) {year} {author}\n"
msgstr "حقوق النشر (C) {year} {author}\n"

#: src/identicon.py:74
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "الرخصة AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/identicon.py:75
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "هذا برمجيات حرة: لك تغييرها وإعادة توزيعها.\n"

#: src/identicon.py:76
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "يعارض هذا المشروع استغلال الذكاء الاصطناعي وهيمنته.\n"

#: src/identicon.py:79
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "يرفض هذا المشروع ترخيص MIT بلا رويّة وترخيص BSD الساذج سياسياً.\n"

#: src/identicon.py:83
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "لا توجد أي ضمانة، في حدود ما يسمح به القانون.\n"

#: src/identicon.py:148 src/identicon.py:172
msgid "invalid size {value!r}"
msgstr "حجم غير صالح {value!r}"

#: src/identicon.py:155
msgid "missing ID"
msgstr "ينقص المعرّف ID"

#: src/identicon.py:157
#, python-brace-format
msgid "extra argument: {arg}"
msgstr "وسيطة زائدة: {arg}"

#: src/identicon.py:165
msgid "unknown type {value!r} (expected {types})"
msgstr "نوع مجهول {value!r} (المتوقع {types})"

#: src/identicon.py:181
msgid "invalid color {value!r}: {err}"
msgstr "لون غير صالح {value!r}: {err}"

#: src/identicon.py:189
msgid "unknown format {value!r}"
msgstr "صيغة مجهولة {value!r}"

#: src/identicon.py:199
#, python-brace-format
msgid "{path} exists (use --force to overwrite)"
msgstr "{path} موجود (للاستبدال استخدم --force)"
